# Plantilla de variables de entorno.
# Copia este archivo como ".env" y rellena los valores reales:
#   cp .env.example .env
# El archivo ".env" NO se versiona (esta en .gitignore).

# Puerto del servidor HTTP
PORT=3100

# Conexion a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gemeloDigital
