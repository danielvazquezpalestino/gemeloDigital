# Plantilla de variables de entorno.
# Copia este archivo como ".env" y rellena los valores reales:
#   cp .env.example .env
# El archivo ".env" NO se versiona (esta en .gitignore).

# Puerto del servidor HTTP
PORT=3100

# Conexion a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gemeloDigital

# Autenticacion: secreto para firmar los tokens de sesion (JWT)
# Genera uno propio, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-en-tu-entorno-local
JWT_EXPIRACION_SEGUNDOS=7200
